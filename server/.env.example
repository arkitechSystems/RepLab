# RepLab server environment variables.
# Copy to server/.env (which is .gitignore'd) and fill in real values.
# In production, set these in the Render dashboard.

# --- Core (already required) ----------------------------------------------
# PostgreSQL connection string from Render.
DATABASE_URL=postgres://user:pass@host:5432/dbname
# JWT signing secret. Long random string; rotate carefully (invalidates sessions).
JWT_SECRET=change-me
# 'production' enables HSTS, CSP, secure cookies, prod fallbacks.
NODE_ENV=development
# Server port (Render sets this automatically; default 3024 locally).
PORT=3024

# --- Cutover-coupled values (server/config.js) ----------------------------
# Public origin of the web app (no trailing slash). Used in emails, Stripe
# return URLs, deep-link handlers, embedded HTML pages. Defaults to
# https://will-fit.shop until LLC cutover; flip to https://replab-fitness.com.
APP_URL=https://will-fit.shop
# Bare host (no scheme) for display strings ("at replab-fitness.com/trainer").
# Defaults to APP_URL with the scheme stripped — only set explicitly if you
# want display text different from the canonical APP_URL host (e.g. www.).
# APP_HOST=replab-fitness.com

# Apple Developer Team ID (App Store Connect → Membership). 10-char string
# like ABCD1234XY. Goes into /.well-known/apple-app-site-association.
APPLE_TEAM_ID=TEAMID
# Bundle ID — must match capacitor.config.json + iOS pbxproj + Android
# build.gradle + strings.xml + Java package + mobile/app.json.
# See MIGRATION.md for the file:line list to flip in lockstep.
APP_BUNDLE_ID=com.willfit.app
# SHA-256 of the Android release signing cert. Generate via:
#   keytool -list -v -keystore your-upload-key.keystore | grep SHA256
# Or copy from Play Console → App signing → App signing key certificate.
# Goes into /.well-known/assetlinks.json.
ANDROID_SIGNING_SHA256=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00

# Resend "from:" addresses. The transactional one is for user-facing email
# (welcome, reset, daily summary); the admin one is for the admin password
# reset specifically. Both must be on a verified Resend domain.
EMAIL_FROM_TRANSACTIONAL=RepLab <noreply@email.will-fit.shop>
EMAIL_FROM_ADMIN=RepLab <noreply@will-fit.shop>

# --- Integrations ---------------------------------------------------------
# Resend API key for outbound email. Without it, emails are silently skipped.
RESEND_API_KEY=
# Admin email for daily summary + signup notifications.
ADMIN_EMAIL=

# Stripe — required only if billing is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_ELITE_MONTHLY_PRICE_ID=
STRIPE_ELITE_YEARLY_PRICE_ID=

# Sentry server DSN (optional).
SENTRY_DSN=

# Anthropic API key for AI workout generator (optional).
ANTHROPIC_API_KEY=

# Admin login. Must be a bcrypt hash starting with $2 — plaintext is rejected
# at startup. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
ADMIN_PASS=
