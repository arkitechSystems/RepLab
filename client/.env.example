# Client-side env vars (Vite). Copy to .env.local for local dev.
# All VITE_* vars are embedded in the client bundle — never put secrets here.

# Sentry DSN for frontend error reporting (optional)
VITE_SENTRY_DSN=

# Posthog product analytics (optional — if blank, analytics is disabled silently)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
